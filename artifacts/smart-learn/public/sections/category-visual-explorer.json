  "html": "<!-- sl-section: category-visual-explorer | v2.0 -->\n<section class=\"sl-category-visual py-5 sl-bg-main\">\n<div class=\"container\">\n<header class=\"text-center mb-5\">\n<h2 class=\"display-6 fw-bold sl-text-emphasis mb-3\" data-sl-edit=\"text\">Browse Top Categories</h2>\n<p class=\"sl-text-muted fs-5\" data-sl-edit=\"text\">Discover programs across various disciplines.</p>\n</header>\n<div class=\"row g-4\">\n<div class=\"col-md-6 col-lg-3\">\n<article class=\"card h-100 border-0 sl-card-radius overflow-hidden sl-hover-card position-relative\" style=\"min-height: 280px;\">\n<div class=\"position-absolute top-0 start-0 w-100 h-100 z-0\">\n<div class=\"sl-media-fallback w-100 h-100 position-absolute z-0\"></div>\n<img alt=\"Technology courses\" class=\"w-100 h-100 object-fit-cover position-relative z-1 sl-hover-zoom\" data-sl-edit=\"image\" decoding=\"async\" loading=\"lazy\" src=\"{{image1}}\"/>\n<div class=\"position-absolute top-0 start-0 w-100 h-100 z-2 sl-scrim\"></div>\n</div>\n<div class=\"card-body p-4 d-flex flex-column justify-content-end position-relative z-3\">\n<h3 class=\"h4 fw-bold text-white mb-2\" data-sl-edit=\"text\">Technology</h3>\n<p class=\"sl-card-sub small mb-3\" data-sl-edit=\"text\">AI · Programming · Cyber</p>\n<div class=\"mt-auto d-flex align-items-center justify-content-between\">\n<span class=\"badge sl-count-pill rounded-pill fw-bold\" data-sl-edit=\"text\">128 Courses</span>\n<span class=\"rounded-circle sl-glass-arrow d-flex align-items-center justify-content-center\" aria-hidden=\"true\">\n<i class=\"fa fa-arrow-right small\" aria-hidden=\"true\"></i>\n</span>\n</div>\n<a aria-label=\"Explore Technology courses\" class=\"stretched-link sl-focus-ring\" data-sl-edit=\"link\" href=\"#technology-courses\"></a>\n</div>\n</article>\n</div>\n<div class=\"col-md-6 col-lg-3\">\n<article class=\"card h-100 border-0 sl-card-radius overflow-hidden sl-hover-card position-relative\" style=\"min-height: 280px;\">\n<div class=\"position-absolute top-0 start-0 w-100 h-100 z-0\">\n<div class=\"sl-media-fallback w-100 h-100 position-absolute z-0\"></div>\n<img alt=\"Business courses\" class=\"w-100 h-100 object-fit-cover position-relative z-1 sl-hover-zoom\" data-sl-edit=\"image\" decoding=\"async\" loading=\"lazy\" src=\"{{image2}}\"/>\n<div class=\"position-absolute top-0 start-0 w-100 h-100 z-2 sl-scrim\"></div>\n</div>\n<div class=\"card-body p-4 d-flex flex-column justify-content-end position-relative z-3\">\n<h3 class=\"h4 fw-bold text-white mb-2\" data-sl-edit=\"text\">Business</h3>\n<p class=\"sl-card-sub small mb-3\" data-sl-edit=\"text\">Finance · Management · HR</p>\n<div class=\"mt-auto d-flex align-items-center justify-content-between\">\n<span class=\"badge sl-count-pill rounded-pill fw-bold\" data-sl-edit=\"text\">84 Courses</span>\n<span class=\"rounded-circle sl-glass-arrow d-flex align-items-center justify-content-center\" aria-hidden=\"true\">\n<i class=\"fa fa-arrow-right small\" aria-hidden=\"true\"></i>\n</span>\n</div>\n<a aria-label=\"Explore Business courses\" class=\"stretched-link sl-focus-ring\" data-sl-edit=\"link\" href=\"#business-courses\"></a>\n</div>\n</article>\n</div>\n<div class=\"col-md-6 col-lg-3\">\n<article class=\"card h-100 border-0 sl-card-radius overflow-hidden sl-hover-card position-relative\" style=\"min-height: 280px;\">\n<div class=\"position-absolute top-0 start-0 w-100 h-100 z-0\">\n<div class=\"sl-media-fallback w-100 h-100 position-absolute z-0\"></div>\n<img alt=\"Design courses\" class=\"w-100 h-100 object-fit-cover position-relative z-1 sl-hover-zoom\" data-sl-edit=\"image\" decoding=\"async\" loading=\"lazy\" src=\"{{image3}}\"/>\n<div class=\"position-absolute top-0 start-0 w-100 h-100 z-2 sl-scrim\"></div>\n</div>\n<div class=\"card-body p-4 d-flex flex-column justify-content-end position-relative z-3\">\n<h3 class=\"h4 fw-bold text-white mb-2\" data-sl-edit=\"text\">Design</h3>\n<p class=\"sl-card-sub small mb-3\" data-sl-edit=\"text\">UI/UX · Graphic · Motion</p>\n<div class=\"mt-auto d-flex align-items-center justify-content-between\">\n<span class=\"badge sl-count-pill rounded-pill fw-bold\" data-sl-edit=\"text\">42 Courses</span>\n<span class=\"rounded-circle sl-glass-arrow d-flex align-items-center justify-content-center\" aria-hidden=\"true\">\n<i class=\"fa fa-arrow-right small\" aria-hidden=\"true\"></i>\n</span>\n</div>\n<a aria-label=\"Explore Design courses\" class=\"stretched-link sl-focus-ring\" data-sl-edit=\"link\" href=\"#design-courses\"></a>\n</div>\n</article>\n</div>\n<div class=\"col-md-6 col-lg-3\">\n<article class=\"card h-100 border-0 sl-card-radius overflow-hidden sl-hover-card position-relative\" style=\"min-height: 280px;\">\n<div class=\"position-absolute top-0 start-0 w-100 h-100 z-0\">\n<div class=\"sl-media-fallback w-100 h-100 position-absolute z-0\"></div>\n<img alt=\"Science courses\" class=\"w-100 h-100 object-fit-cover position-relative z-1 sl-hover-zoom\" data-sl-edit=\"image\" decoding=\"async\" loading=\"lazy\" src=\"{{image4}}\"/>\n<div class=\"position-absolute top-0 start-0 w-100 h-100 z-2 sl-scrim\"></div>\n</div>\n<div class=\"card-body p-4 d-flex flex-column justify-content-end position-relative z-3\">\n<h3 class=\"h4 fw-bold text-white mb-2\" data-sl-edit=\"text\">Science</h3>\n<p class=\"sl-card-sub small mb-3\" data-sl-edit=\"text\">Physics · Biology · Chemistry</p>\n<div class=\"mt-auto d-flex align-items-center justify-content-between\">\n<span class=\"badge sl-count-pill rounded-pill fw-bold\" data-sl-edit=\"text\">65 Courses</span>\n<span class=\"rounded-circle sl-glass-arrow d-flex align-items-center justify-content-center\" aria-hidden=\"true\">\n<i class=\"fa fa-arrow-right small\" aria-hidden=\"true\"></i>\n</span>\n</div>\n<a aria-label=\"Explore Science courses\" class=\"stretched-link sl-focus-ring\" data-sl-edit=\"link\" href=\"#science-courses\"></a>\n</div>\n</article>\n</div>\n</div>\n</div>\n</section>",
  "css": ".sl-category-visual.sl-bg-main { background-color: var(--smartlearn-bg); }\n.sl-category-visual .sl-text-emphasis { color: var(--smartlearn-text); }\n.sl-category-visual .sl-text-muted { color: var(--smartlearn-text-muted); }\n.sl-category-visual h2, .sl-category-visual h3 { font-family: var(--smartlearn-heading-font, inherit); }\n.sl-category-visual .sl-card-radius { border-radius: var(--smartlearn-radius, 1rem); }\n.sl-category-visual .sl-media-fallback { background-color: var(--smartlearn-card-bg); }\n.sl-category-visual .sl-scrim { background: linear-gradient(to top, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.15) 100%); }\n.sl-category-visual .sl-card-sub { color: rgba(255, 255, 255, 0.92); }\n.sl-category-visual .sl-count-pill {\n    background-color: var(--smartlearn-card-bg);\n    color: var(--smartlearn-text);\n    border: 1px solid var(--smartlearn-card-border);\n    padding: 0.4em 0.75em;\n}\n.sl-category-visual .sl-glass-arrow {\n    width: 36px;\n    height: 36px;\n    background-color: rgba(255, 255, 255, 0.22);\n    color: #ffffff;\n    border: 1px solid rgba(255, 255, 255, 0.35);\n    backdrop-filter: blur(6px);\n    -webkit-backdrop-filter: blur(6px);\n}\n.sl-category-visual .sl-focus-ring:focus-visible {\n    outline: 3px solid var(--smartlearn-primary);\n    outline-offset: 3px;\n}\n.sl-category-visual .sl-hover-zoom { transition: transform 0.6s ease; }\n@media (hover: hover) and (prefers-reduced-motion: no-preference) {\n    .sl-category-visual .sl-hover-card { transition: transform 0.3s ease, box-shadow 0.3s ease; }\n    .sl-category-visual .sl-hover-card:hover { transform: translateY(-5px); box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.14); }\n    .sl-category-visual .sl-hover-card:hover .sl-hover-zoom { transform: scale(1.05); }\n}\n@media (prefers-reduced-motion: reduce) {\n    .sl-category-visual .sl-hover-zoom, .sl-category-visual .sl-hover-card { transition: none; }\n}\n@media (min-width: 992px) {\n    .sl-category-visual { padding-top: 6rem !important; padding-bottom: 6rem !important; }\n}\n[dir=\"rtl\"] .sl-category-visual .fa-arrow-right { transform: scaleX(-1); }\n",
