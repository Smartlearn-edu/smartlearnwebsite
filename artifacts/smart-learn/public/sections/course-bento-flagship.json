  "html": "<!-- sl-section: course-bento-flagship | v1.0 -->\n<section class=\"sl-course-bento py-5 py-lg-6 sl-bg-main\">\n<div class=\"container\">\n<header class=\"d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3\">\n<div>\n<h2 class=\"display-6 fw-bold sl-text-emphasis mb-2\" data-sl-edit=\"text\">Flagship Programs</h2>\n<p class=\"sl-text-muted fs-5 mb-0\" data-sl-edit=\"text\">Our highest-rated, comprehensive curriculums.</p>\n</div>\n<a class=\"fw-bold sl-text-primary text-decoration-none sl-focus-ring\" data-sl-edit=\"link\" href=\"#view-all-programs\">View all programs <i class=\"fa fa-arrow-right ms-2\"></i></a>\n</header>\n<div class=\"row g-4\">\n<!-- Massive Hero Course -->\n<div class=\"col-lg-7\">\n<a class=\"card h-100 border-0 sl-bg-card sl-border rounded-4 overflow-hidden text-decoration-none sl-hover-card sl-focus-ring position-relative\" data-sl-edit=\"link\" data-sl-edit-text=\"BOOTCAMPFull-Stack Software En\" href=\"#bootcampfull-stack-s\">\n<div class=\"position-absolute top-0 start-0 w-100 h-100 z-0\">\n<div class=\"sl-media-fallback w-100 h-100 position-absolute z-0\"></div>\n<img alt=\"Hero Course\" class=\"w-100 h-100 object-fit-cover position-relative z-1 sl-hover-zoom\" data-sl-edit=\"image\" loading=\"lazy\" src=\"https://picsum.photos/seed/slbentohero/800/800\"/>\n<div class=\"position-absolute top-0 start-0 w-100 h-100 z-2\" style=\"background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 80%);\"></div>\n</div>\n<div class=\"card-body p-4 p-md-5 d-flex flex-column justify-content-end position-relative z-3\" style=\"min-height: 400px;\">\n<span class=\"badge sl-bg-primary text-white rounded-pill fw-bold shadow-sm mb-3 align-self-start\" data-sl-edit=\"text\">BOOTCAMP</span>\n<h3 class=\"display-5 fw-bold text-white mb-3\" data-sl-edit=\"text\">Full-Stack Software Engineering</h3>\n<p class=\"text-white opacity-75 fs-5 mb-4\" data-sl-edit=\"text\">Zero to deployment in 24 weeks. Master React, Node, and Cloud Infrastructure.</p>\n<div class=\"d-flex align-items-center gap-4 text-white\">\n<div class=\"d-flex align-items-center gap-2\">\n<i class=\"fa fa-star text-warning\"></i>\n<span class=\"fw-bold\">4.9</span>\n</div>\n<div class=\"d-flex align-items-center gap-2 opacity-75\">\n<i class=\"fa fa-users\"></i>\n<span>12,000+ Enrolled</span>\n</div>\n</div>\n</div>\n</a>\n</div>\n<!-- Bento Right Column: 2x2 Grid of smaller courses -->\n<div class=\"col-lg-5\">\n<div class=\"row g-4 h-100\">\n<!-- Sub Course 1 -->\n<div class=\"col-sm-6\">\n<a class=\"card h-100 sl-bg-card sl-border rounded-4 overflow-hidden text-decoration-none sl-hover-card sl-focus-ring d-flex flex-column\" data-sl-edit=\"link\" data-sl-edit-text=\"React Patterns4 Weeks \u00b7 Adv.\" href=\"#react-patterns4-week\">\n<div class=\"position-relative\" style=\"height: 140px;\">\n<div class=\"sl-media-fallback w-100 h-100 position-absolute z-0\"></div>\n<img alt=\"Course\" class=\"w-100 h-100 object-fit-cover position-relative z-1 sl-hover-zoom\" data-sl-edit=\"image\" loading=\"lazy\" src=\"https://picsum.photos/seed/slbento1/400/300\"/>\n</div>\n<div class=\"card-body p-3 d-flex flex-column\">\n<h4 class=\"h6 fw-bold sl-text-emphasis mb-2 lh-base\" data-sl-edit=\"text\">React Patterns</h4>\n<div class=\"mt-auto small sl-text-muted fw-bold\">4 Weeks \u00b7 Adv.</div>\n</div>\n</a>\n</div>\n<!-- Sub Course 2 -->\n<div class=\"col-sm-6\">\n<a class=\"card h-100 sl-bg-card sl-border rounded-4 overflow-hidden text-decoration-none sl-hover-card sl-focus-ring d-flex flex-column\" data-sl-edit=\"link\" data-sl-edit-text=\"Node.js APIs6 Weeks \u00b7 Int.\" href=\"#node-js-apis6-weeks-\">\n<div class=\"position-relative\" style=\"height: 140px;\">\n<div class=\"sl-media-fallback w-100 h-100 position-absolute z-0\"></div>\n<img alt=\"Course\" class=\"w-100 h-100 object-fit-cover position-relative z-1 sl-hover-zoom\" data-sl-edit=\"image\" loading=\"lazy\" src=\"https://picsum.photos/seed/slbento2/400/300\"/>\n</div>\n<div class=\"card-body p-3 d-flex flex-column\">\n<h4 class=\"h6 fw-bold sl-text-emphasis mb-2 lh-base\" data-sl-edit=\"text\">Node.js APIs</h4>\n<div class=\"mt-auto small sl-text-muted fw-bold\">6 Weeks \u00b7 Int.</div>\n</div>\n</a>\n</div>\n<!-- Sub Course 3 -->\n<div class=\"col-sm-6\">\n<a class=\"card h-100 sl-bg-card sl-border rounded-4 overflow-hidden text-decoration-none sl-hover-card sl-focus-ring d-flex flex-column\" data-sl-edit=\"link\" data-sl-edit-text=\"Docker Mastery3 Weeks \u00b7 Int.\" href=\"#docker-mastery3-week\">\n<div class=\"position-relative\" style=\"height: 140px;\">\n<div class=\"sl-media-fallback w-100 h-100 position-absolute z-0\"></div>\n<img alt=\"Course\" class=\"w-100 h-100 object-fit-cover position-relative z-1 sl-hover-zoom\" data-sl-edit=\"image\" loading=\"lazy\" src=\"https://picsum.photos/seed/slbento3/400/300\"/>\n</div>\n<div class=\"card-body p-3 d-flex flex-column\">\n<h4 class=\"h6 fw-bold sl-text-emphasis mb-2 lh-base\" data-sl-edit=\"text\">Docker Mastery</h4>\n<div class=\"mt-auto small sl-text-muted fw-bold\">3 Weeks \u00b7 Int.</div>\n</div>\n</a>\n</div>\n<!-- Sub Course 4 -->\n<div class=\"col-sm-6\">\n<a class=\"card h-100 sl-bg-card sl-border rounded-4 overflow-hidden text-decoration-none sl-hover-card sl-focus-ring d-flex flex-column\" data-sl-edit=\"link\" data-sl-edit-text=\"CI/CD Pipelines2 Weeks \u00b7 Adv.\" href=\"#ci-cd-pipelines2-wee\">\n<div class=\"position-relative\" style=\"height: 140px;\">\n<div class=\"sl-media-fallback w-100 h-100 position-absolute z-0\"></div>\n<img alt=\"Course\" class=\"w-100 h-100 object-fit-cover position-relative z-1 sl-hover-zoom\" data-sl-edit=\"image\" loading=\"lazy\" src=\"https://picsum.photos/seed/slbento4/400/300\"/>\n</div>\n<div class=\"card-body p-3 d-flex flex-column\">\n<h4 class=\"h6 fw-bold sl-text-emphasis mb-2 lh-base\" data-sl-edit=\"text\">CI/CD Pipelines</h4>\n<div class=\"mt-auto small sl-text-muted fw-bold\">2 Weeks \u00b7 Adv.</div>\n</div>\n</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>",
  "css": "\n/* SmartLearn Native Color Classes */\n.sl-text-primary { color: var(--smartlearn-primary) !important; }\n.sl-text-emphasis { color: var(--smartlearn-text) !important; }\n.sl-text-muted { color: var(--smartlearn-text-muted) !important; }\n\n.sl-bg-main { background-color: var(--smartlearn-bg) !important; }\n.sl-bg-card { background-color: var(--smartlearn-card-bg) !important; border: 1px solid var(--smartlearn-card-border) !important; }\n.sl-bg-primary { background-color: var(--smartlearn-primary) !important; }\n\n.sl-border { border-color: var(--smartlearn-card-border) !important; }\n.sl-border-primary { border-color: var(--smartlearn-primary) !important; }\n\n/* Media Fallbacks */\n.sl-course-bento .sl-media-fallback {\n    background-color: var(--smartlearn-card-bg);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--smartlearn-text-muted);\n}\n\n/* Base Accessibility */\n.sl-course-bento .sl-focus-ring:focus-visible {\n    outline: 3px solid var(--smartlearn-primary);\n    outline-offset: 3px;\n}\n\n/* Smooth zoom on hover for images */\n.sl-course-bento .sl-hover-zoom { transition: transform 0.6s ease; }\n@media (hover: hover) and (prefers-reduced-motion: no-preference) {\n    .sl-course-bento .sl-hover-card:hover .sl-hover-zoom { transform: scale(1.05); }\n    .sl-course-bento .sl-hover-card { transition: transform 0.3s ease, box-shadow 0.3s ease; }\n    .sl-course-bento .sl-hover-card:hover { \n        transform: translateY(-5px);\n        box-shadow: 0 1rem 2rem rgba(0,0,0,0.1) !important;\n    }\n}\n\n.sl-course-bento .py-lg-6 { padding-top: 6rem; padding-bottom: 6rem; }\n",
