  "html": "<!-- sl-section: course-classic-grid | v2.0 -->\n<section class=\"sl-course-grid py-5 sl-bg-main\">\n<div class=\"container\">\n<header class=\"d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3\">\n<div style=\"max-width: 600px;\">\n<h2 class=\"display-6 fw-bold sl-text-emphasis mb-2\" data-sl-edit=\"text\">Featured Courses</h2>\n<p class=\"sl-text-muted fs-5 mb-0\" data-sl-edit=\"text\">Explore our most popular programs taught by industry experts.</p>\n</div>\n<a class=\"btn sl-btn-outline rounded-pill px-4 fw-bold flex-shrink-0 sl-focus-ring\" data-sl-edit=\"link\" href=\"#view-full-catalog\">View Full Catalog</a>\n</header>\n<div class=\"row g-4\">\n<div class=\"col-md-6 col-lg-4\">\n<article class=\"card h-100 sl-bg-card sl-border sl-card-radius overflow-hidden sl-hover-card d-flex flex-column position-relative\">\n<div class=\"position-relative\" style=\"height: 220px;\">\n<div class=\"sl-media-fallback w-100 h-100 position-absolute z-0\"></div>\n<img alt=\"Python for Data Analysis\" class=\"w-100 h-100 object-fit-cover position-relative z-1 sl-hover-zoom\" data-sl-edit=\"image\" decoding=\"async\" loading=\"lazy\" src=\"{{image1}}\"/>\n<div class=\"position-absolute top-0 end-0 p-3 z-2\">\n<span class=\"badge sl-level-badge rounded-pill fw-bold shadow-sm\" data-sl-edit=\"text\">Intermediate</span>\n</div>\n</div>\n<div class=\"card-body p-4 d-flex flex-column flex-grow-1\">\n<div class=\"d-flex align-items-center justify-content-between mb-3 small fw-bold\">\n<span class=\"sl-text-primary sl-tracking-wide text-uppercase\" data-sl-edit=\"text\">Data Science</span>\n<div class=\"sl-text-emphasis\">\n<i class=\"fa fa-star text-warning\" aria-hidden=\"true\"></i> <span data-sl-edit=\"text\">4.8</span> <span class=\"sl-text-muted fw-normal\" data-sl-edit=\"text\">(1.2k)</span>\n</div>\n</div>\n<h3 class=\"h5 fw-bold sl-text-emphasis mb-3\" data-sl-edit=\"text\">Python for Data Analysis</h3>\n<div class=\"mt-auto pt-3 border-top sl-border d-flex align-items-center justify-content-between\">\n<div class=\"d-flex align-items-center gap-2\">\n<div class=\"rounded-circle sl-avatar-circle d-flex align-items-center justify-content-center border sl-border overflow-hidden flex-shrink-0\" style=\"width: 32px; height: 32px;\" aria-hidden=\"true\">\n<i class=\"fa fa-user sl-text-muted small\" aria-hidden=\"true\"></i>\n</div>\n<span class=\"small fw-bold sl-text-emphasis\" data-sl-edit=\"text\">Dr. S. Jenkins</span>\n</div>\n<span class=\"small fw-bold sl-text-muted d-inline-flex align-items-center gap-1\">\n<i class=\"fa fa-clock\" aria-hidden=\"true\"></i>\n<span data-sl-edit=\"text\">12 Weeks</span>\n</span>\n</div>\n<a aria-label=\"Explore Python for Data Analysis\" class=\"stretched-link sl-focus-ring\" data-sl-edit=\"link\" href=\"#python-data-analysis\"></a>\n</div>\n</article>\n</div>\n<div class=\"col-md-6 col-lg-4\">\n<article class=\"card h-100 sl-bg-card sl-border sl-card-radius overflow-hidden sl-hover-card d-flex flex-column position-relative\">\n<div class=\"position-relative\" style=\"height: 220px;\">\n<div class=\"sl-media-fallback w-100 h-100 position-absolute z-0\"></div>\n<img alt=\"UI/UX Foundations\" class=\"w-100 h-100 object-fit-cover position-relative z-1 sl-hover-zoom\" data-sl-edit=\"image\" decoding=\"async\" loading=\"lazy\" src=\"{{image2}}\"/>\n<div class=\"position-absolute top-0 end-0 p-3 z-2\">\n<span class=\"badge sl-level-badge rounded-pill fw-bold shadow-sm\" data-sl-edit=\"text\">Beginner</span>\n</div>\n</div>\n<div class=\"card-body p-4 d-flex flex-column flex-grow-1\">\n<div class=\"d-flex align-items-center justify-content-between mb-3 small fw-bold\">\n<span class=\"sl-text-primary sl-tracking-wide text-uppercase\" data-sl-edit=\"text\">Design</span>\n<div class=\"sl-text-emphasis\">\n<i class=\"fa fa-star text-warning\" aria-hidden=\"true\"></i> <span data-sl-edit=\"text\">4.9</span> <span class=\"sl-text-muted fw-normal\" data-sl-edit=\"text\">(850)</span>\n</div>\n</div>\n<h3 class=\"h5 fw-bold sl-text-emphasis mb-3\" data-sl-edit=\"text\">UI/UX Foundations</h3>\n<div class=\"mt-auto pt-3 border-top sl-border d-flex align-items-center justify-content-between\">\n<div class=\"d-flex align-items-center gap-2\">\n<div class=\"rounded-circle sl-avatar-circle d-flex align-items-center justify-content-center border sl-border overflow-hidden flex-shrink-0\" style=\"width: 32px; height: 32px;\" aria-hidden=\"true\">\n<i class=\"fa fa-user sl-text-muted small\" aria-hidden=\"true\"></i>\n</div>\n<span class=\"small fw-bold sl-text-emphasis\" data-sl-edit=\"text\">Elena Rostova</span>\n</div>\n<span class=\"small fw-bold sl-text-muted d-inline-flex align-items-center gap-1\">\n<i class=\"fa fa-clock\" aria-hidden=\"true\"></i>\n<span data-sl-edit=\"text\">8 Weeks</span>\n</span>\n</div>\n<a aria-label=\"Explore UI/UX Foundations\" class=\"stretched-link sl-focus-ring\" data-sl-edit=\"link\" href=\"#uiux-foundations\"></a>\n</div>\n</article>\n</div>\n<div class=\"col-md-6 col-lg-4\">\n<article class=\"card h-100 sl-bg-card sl-border sl-card-radius overflow-hidden sl-hover-card d-flex flex-column position-relative\">\n<div class=\"position-relative\" style=\"height: 220px;\">\n<div class=\"sl-media-fallback w-100 h-100 position-absolute z-0\"></div>\n<img alt=\"System Design Architecture\" class=\"w-100 h-100 object-fit-cover position-relative z-1 sl-hover-zoom\" data-sl-edit=\"image\" decoding=\"async\" loading=\"lazy\" src=\"{{image3}}\"/>\n<div class=\"position-absolute top-0 end-0 p-3 z-2\">\n<span class=\"badge sl-level-badge-primary rounded-pill fw-bold shadow-sm\" data-sl-edit=\"text\">Advanced</span>\n</div>\n</div>\n<div class=\"card-body p-4 d-flex flex-column flex-grow-1\">\n<div class=\"d-flex align-items-center justify-content-between mb-3 small fw-bold\">\n<span class=\"sl-text-primary sl-tracking-wide text-uppercase\" data-sl-edit=\"text\">Engineering</span>\n<div class=\"sl-text-emphasis\">\n<i class=\"fa fa-star text-warning\" aria-hidden=\"true\"></i> <span data-sl-edit=\"text\">4.7</span> <span class=\"sl-text-muted fw-normal\" data-sl-edit=\"text\">(2.1k)</span>\n</div>\n</div>\n<h3 class=\"h5 fw-bold sl-text-emphasis mb-3\" data-sl-edit=\"text\">System Design Architecture</h3>\n<div class=\"mt-auto pt-3 border-top sl-border d-flex align-items-center justify-content-between\">\n<div class=\"d-flex align-items-center gap-2\">\n<div class=\"rounded-circle sl-avatar-circle d-flex align-items-center justify-content-center border sl-border overflow-hidden flex-shrink-0\" style=\"width: 32px; height: 32px;\" aria-hidden=\"true\">\n<i class=\"fa fa-user sl-text-muted small\" aria-hidden=\"true\"></i>\n</div>\n<span class=\"small fw-bold sl-text-emphasis\" data-sl-edit=\"text\">M. Chen</span>\n</div>\n<span class=\"small fw-bold sl-text-muted d-inline-flex align-items-center gap-1\">\n<i class=\"fa fa-clock\" aria-hidden=\"true\"></i>\n<span data-sl-edit=\"text\">16 Weeks</span>\n</span>\n</div>\n<a aria-label=\"Explore System Design Architecture\" class=\"stretched-link sl-focus-ring\" data-sl-edit=\"link\" href=\"#system-design-architecture\"></a>\n</div>\n</article>\n</div>\n</div>\n</div>\n</section>",
  "css": ".sl-course-grid.sl-bg-main { background-color: var(--smartlearn-bg); }\n.sl-course-grid .sl-avatar-circle { background-color: var(--smartlearn-bg); }\n.sl-course-grid .sl-text-primary { color: var(--smartlearn-primary); }\n.sl-course-grid .sl-text-emphasis { color: var(--smartlearn-text); }\n.sl-course-grid .sl-text-muted { color: var(--smartlearn-text-muted); }\n.sl-course-grid .sl-bg-card { background-color: var(--smartlearn-card-bg); border: 1px solid var(--smartlearn-card-border); }\n.sl-course-grid .sl-border { border-color: var(--smartlearn-card-border); }\n.sl-course-grid .sl-card-radius { border-radius: var(--smartlearn-radius, 1rem); }\n.sl-course-grid h2, .sl-course-grid h3 { font-family: var(--smartlearn-heading-font, inherit); }\n.sl-course-grid .sl-tracking-wide { letter-spacing: 0.1em; }\n.sl-course-grid .sl-btn-outline {\n    background-color: transparent;\n    color: var(--smartlearn-text);\n    border: 1px solid var(--smartlearn-card-border);\n    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;\n}\n.sl-course-grid .sl-btn-outline:hover,\n.sl-course-grid .sl-btn-outline:focus-visible {\n    background-color: var(--smartlearn-btn-bg);\n    border-color: var(--smartlearn-btn-bg);\n    color: var(--smartlearn-btn-text);\n}\n.sl-course-grid .sl-level-badge {\n    background-color: var(--smartlearn-card-bg);\n    color: var(--smartlearn-text);\n    border: 1px solid var(--smartlearn-card-border);\n    padding: 0.45em 0.8em;\n}\n.sl-course-grid .sl-level-badge-primary {\n    background-color: var(--smartlearn-btn-bg);\n    color: var(--smartlearn-btn-text);\n    padding: 0.45em 0.8em;\n}\n.sl-course-grid .sl-media-fallback { background-color: var(--smartlearn-card-bg); }\n.sl-course-grid .sl-focus-ring:focus-visible {\n    outline: 3px solid var(--smartlearn-primary);\n    outline-offset: 3px;\n}\n.sl-course-grid .sl-hover-zoom { transition: transform 0.6s ease; }\n@media (hover: hover) and (prefers-reduced-motion: no-preference) {\n    .sl-course-grid .sl-hover-card { transition: transform 0.3s ease, box-shadow 0.3s ease; }\n    .sl-course-grid .sl-hover-card:hover { transform: translateY(-5px); box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.1); }\n    .sl-course-grid .sl-hover-card:hover .sl-hover-zoom { transform: scale(1.05); }\n}\n@media (prefers-reduced-motion: reduce) {\n    .sl-course-grid .sl-hover-zoom, .sl-course-grid .sl-hover-card, .sl-course-grid .sl-btn-outline { transition: none; }\n}\n@media (min-width: 992px) {\n    .sl-course-grid { padding-top: 6rem !important; padding-bottom: 6rem !important; }\n}\n",
