  "html": "<!-- sl-section: footer-mega | v1.0 -->\n<footer class=\"sl-footer-mega sl-bg-card pt-6 pb-4 border-top sl-border\">\n<div class=\"container\">\n<!-- Mega Category Grid -->\n<div class=\"row mb-5 pb-5 border-bottom sl-border\">\n<div class=\"col-12 mb-4\">\n<h4 class=\"fw-bold sl-text-emphasis\" data-sl-edit=\"text\">Explore Categories</h4>\n</div>\n<div class=\"col-md-3 col-sm-6 mb-4 mb-md-0\">\n<ul class=\"list-unstyled d-flex flex-column gap-2\">\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link d-flex align-items-center\" data-sl-edit=\"link\" href=\"#development\"><div class=\"sl-icon-wrapper sl-bg-primary-subtle rounded d-flex align-items-center justify-content-center me-3\"><i class=\"fa fa-code sl-text-primary\"></i></div>Development</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link d-flex align-items-center\" data-sl-edit=\"link\" href=\"#business\"><div class=\"sl-icon-wrapper sl-bg-primary-subtle rounded d-flex align-items-center justify-content-center me-3\"><i class=\"fa fa-briefcase sl-text-primary\"></i></div>Business</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link d-flex align-items-center\" data-sl-edit=\"link\" href=\"#finance\"><div class=\"sl-icon-wrapper sl-bg-primary-subtle rounded d-flex align-items-center justify-content-center me-3\"><i class=\"fa fa-money sl-text-primary\"></i></div>Finance</a></li>\n</ul>\n</div>\n<div class=\"col-md-3 col-sm-6 mb-4 mb-md-0\">\n<ul class=\"list-unstyled d-flex flex-column gap-2\">\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link d-flex align-items-center\" data-sl-edit=\"link\" href=\"#design\"><div class=\"sl-icon-wrapper sl-bg-primary-subtle rounded d-flex align-items-center justify-content-center me-3\"><i class=\"fa fa-paint-brush sl-text-primary\"></i></div>Design</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link d-flex align-items-center\" data-sl-edit=\"link\" href=\"#marketing\"><div class=\"sl-icon-wrapper sl-bg-primary-subtle rounded d-flex align-items-center justify-content-center me-3\"><i class=\"fa fa-bullhorn sl-text-primary\"></i></div>Marketing</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link d-flex align-items-center\" data-sl-edit=\"link\" href=\"#photography\"><div class=\"sl-icon-wrapper sl-bg-primary-subtle rounded d-flex align-items-center justify-content-center me-3\"><i class=\"fa fa-camera sl-text-primary\"></i></div>Photography</a></li>\n</ul>\n</div>\n<div class=\"col-md-3 col-sm-6 mb-4 mb-md-0\">\n<ul class=\"list-unstyled d-flex flex-column gap-2\">\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link d-flex align-items-center\" data-sl-edit=\"link\" href=\"#health-fitness\"><div class=\"sl-icon-wrapper sl-bg-primary-subtle rounded d-flex align-items-center justify-content-center me-3\"><i class=\"fa fa-heartbeat sl-text-primary\"></i></div>Health &amp; Fitness</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link d-flex align-items-center\" data-sl-edit=\"link\" href=\"#music\"><div class=\"sl-icon-wrapper sl-bg-primary-subtle rounded d-flex align-items-center justify-content-center me-3\"><i class=\"fa fa-music sl-text-primary\"></i></div>Music</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link d-flex align-items-center\" data-sl-edit=\"link\" href=\"#science\"><div class=\"sl-icon-wrapper sl-bg-primary-subtle rounded d-flex align-items-center justify-content-center me-3\"><i class=\"fa fa-flask sl-text-primary\"></i></div>Science</a></li>\n</ul>\n</div>\n<div class=\"col-md-3 col-sm-6\">\n<ul class=\"list-unstyled d-flex flex-column gap-2\">\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link d-flex align-items-center\" data-sl-edit=\"link\" href=\"#languages\"><div class=\"sl-icon-wrapper sl-bg-primary-subtle rounded d-flex align-items-center justify-content-center me-3\"><i class=\"fa fa-language sl-text-primary\"></i></div>Languages</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link d-flex align-items-center\" data-sl-edit=\"link\" href=\"#personal-dev\"><div class=\"sl-icon-wrapper sl-bg-primary-subtle rounded d-flex align-items-center justify-content-center me-3\"><i class=\"fa fa-users sl-text-primary\"></i></div>Personal Dev</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link d-flex align-items-center\" data-sl-edit=\"link\" href=\"#it-software\"><div class=\"sl-icon-wrapper sl-bg-primary-subtle rounded d-flex align-items-center justify-content-center me-3\"><i class=\"fa fa-desktop sl-text-primary\"></i></div>IT &amp; Software</a></li>\n</ul>\n</div>\n</div>\n<!-- Standard Footer Links -->\n<div class=\"row gy-4 mb-5\">\n<div class=\"col-lg-5 pe-lg-5\">\n<h3 class=\"fw-bold sl-text-emphasis mb-3\" data-sl-edit=\"text\">SmartLearn Hub</h3>\n<p class=\"sl-text-muted mb-4\" data-sl-edit=\"text\">The world's largest selection of online courses. Learn anytime, anywhere, at your own pace.</p>\n<a class=\"btn sl-btn-primary rounded-pill px-4\" data-sl-edit=\"link\" href=\"#explore-all-courses\">Explore All Courses</a>\n</div>\n<div class=\"col-lg-7\">\n<div class=\"row\">\n<div class=\"col-sm-4 mb-4\">\n<h4 class=\"fw-bold sl-text-emphasis mb-3 text-uppercase small\" data-sl-edit=\"text\">Learn</h4>\n<ul class=\"list-unstyled d-flex flex-column gap-2\">\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link\" data-sl-edit=\"link\" href=\"#learning-paths\">Learning Paths</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link\" data-sl-edit=\"link\" href=\"#certifications\">Certifications</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link\" data-sl-edit=\"link\" href=\"#free-courses\">Free Courses</a></li>\n</ul>\n</div>\n<div class=\"col-sm-4 mb-4\">\n<h4 class=\"fw-bold sl-text-emphasis mb-3 text-uppercase small\" data-sl-edit=\"text\">Community</h4>\n<ul class=\"list-unstyled d-flex flex-column gap-2\">\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link\" data-sl-edit=\"link\" href=\"#instructors\">Instructors</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link\" data-sl-edit=\"link\" href=\"#student-forums\">Student Forums</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link\" data-sl-edit=\"link\" href=\"#blog\">Blog</a></li>\n</ul>\n</div>\n<div class=\"col-sm-4 mb-4\">\n<h4 class=\"fw-bold sl-text-emphasis mb-3 text-uppercase small\" data-sl-edit=\"text\">Support</h4>\n<ul class=\"list-unstyled d-flex flex-column gap-2\">\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link\" data-sl-edit=\"link\" href=\"#help-center\">Help Center</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link\" data-sl-edit=\"link\" href=\"#system-requirements\">System Requirements</a></li>\n<li><a class=\"text-decoration-none sl-text-muted sl-footer-link\" data-sl-edit=\"link\" href=\"#contact-us\">Contact Us</a></li>\n</ul>\n</div>\n</div>\n</div>\n</div>\n<div class=\"d-flex flex-column flex-md-row justify-content-between align-items-center pt-4 border-top sl-border\">\n<span class=\"small sl-text-muted mb-3 mb-md-0\" data-sl-edit=\"text\">© 2026 SmartLearn Hub. All rights reserved.</span>\n<div class=\"d-flex gap-3\">\n<a class=\"text-decoration-none small sl-text-muted sl-footer-link\" data-sl-edit=\"link\" href=\"#privacy\">Privacy</a>\n<a class=\"text-decoration-none small sl-text-muted sl-footer-link\" data-sl-edit=\"link\" href=\"#terms\">Terms</a>\n<a class=\"text-decoration-none small sl-text-muted sl-footer-link\" data-sl-edit=\"link\" href=\"#sitemap\">Sitemap</a>\n</div>\n</div>\n</div>\n</footer>",
  "css": "\n/* SmartLearn Native Color Classes */\n.sl-text-primary { color: var(--smartlearn-primary) !important; }\n.sl-text-emphasis { color: var(--smartlearn-text) !important; }\n.sl-text-muted { color: var(--smartlearn-text-muted) !important; }\n\n.sl-bg-main { background-color: var(--smartlearn-bg) !important; }\n.sl-bg-card { background-color: var(--smartlearn-card-bg) !important; border: 1px solid var(--smartlearn-card-border) !important; }\n.sl-bg-primary { background-color: var(--smartlearn-primary) !important; }\n.sl-footer-mega .sl-bg-primary-subtle { background-color: color-mix(in srgb, var(--smartlearn-primary) 10%, transparent) !important; }\n\n/* Buttons */\n.sl-footer-mega .sl-btn-primary {\n    background-color: var(--smartlearn-primary) !important;\n    border-color: var(--smartlearn-primary) !important;\n    color: #FFFFFF !important;\n}\n.sl-footer-mega .sl-btn-primary:hover, .sl-footer-mega .sl-btn-primary:focus, .sl-footer-mega .sl-btn-primary:active {\n    background-color: var(--smartlearn-primary-hover, var(--smartlearn-primary)) !important;\n    filter: brightness(0.9);\n    color: #FFFFFF !important;\n    box-shadow: 0 4px 12px color-mix(in srgb, var(--smartlearn-primary) 30%, transparent) !important;\n}\n\n.sl-footer-mega .sl-btn-outline-primary {\n    border-color: var(--smartlearn-primary) !important;\n    color: var(--smartlearn-primary) !important;\n}\n.sl-footer-mega .sl-btn-outline-primary:hover, .sl-footer-mega .sl-btn-outline-primary:focus, .sl-footer-mega .sl-btn-outline-primary:active {\n    background-color: var(--smartlearn-primary) !important;\n    color: #FFFFFF !important;\n}\n\n/* Borders */\n.sl-border-primary { border-color: var(--smartlearn-primary) !important; }\n.sl-border { border-color: var(--smartlearn-card-border) !important; }\n\n.sl-footer-mega .sl-icon-wrapper { width: 32px; height: 32px; transition: background-color 0.2s ease; }\n.sl-footer-mega .sl-footer-link { transition: all 0.2s ease; }\n.sl-footer-mega .sl-footer-link:hover, .sl-footer-mega .sl-footer-link:focus { color: var(--smartlearn-primary) !important; padding-left: 6px; }\n.sl-footer-mega .sl-footer-link:hover .sl-icon-wrapper { background-color: var(--smartlearn-primary) !important; }\n.sl-footer-mega .sl-footer-link:hover .sl-icon-wrapper i { color: #FFFFFF !important; }\n",
  "js": "(function() { const root = document.querySelector('.sl-footer-mega'); if (!root) return; })();"
