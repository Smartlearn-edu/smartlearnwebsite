  "html": "<!-- sl-section: footer-mega | v2.0 -->\n<footer role=\"contentinfo\" class=\"sl-footer-mega pb-4 border-top sl-border\">\n<div class=\"container\">\n<div class=\"row mb-5 pb-5 border-bottom sl-border\">\n<div class=\"col-12 mb-4\">\n<h2 class=\"h4 fw-bold sl-text-emphasis\" data-sl-edit=\"text\">Explore Categories</h2>\n</div>\n<nav aria-label=\"Course Categories\" class=\"col-12\">\n<div class=\"row\">\n<div class=\"col-md-3 col-sm-6 mb-4 mb-md-0\">\n<div class=\"d-flex flex-column gap-2\">\n<div class=\"sl-cat-row d-flex align-items-center gap-3 position-relative\">\n<div class=\"sl-icon-wrapper sl-icon-subtle rounded d-flex align-items-center justify-content-center flex-shrink-0\" aria-hidden=\"true\"><i class=\"fa fa-code sl-text-primary\"></i></div>\n<a class=\"text-decoration-none sl-text-muted sl-footer-link sl-footer-nav-link stretched-link\" data-sl-edit=\"link\" href=\"#development\">Development</a>\n</div>\n<div class=\"sl-cat-row d-flex align-items-center gap-3 position-relative\">\n<div class=\"sl-icon-wrapper sl-icon-subtle rounded d-flex align-items-center justify-content-center flex-shrink-0\" aria-hidden=\"true\"><i class=\"fa fa-briefcase sl-text-primary\"></i></div>\n<a class=\"text-decoration-none sl-text-muted sl-footer-link sl-footer-nav-link stretched-link\" data-sl-edit=\"link\" href=\"#business\">Business</a>\n</div>\n<div class=\"sl-cat-row d-flex align-items-center gap-3 position-relative\">\n<div class=\"sl-icon-wrapper sl-icon-subtle rounded d-flex align-items-center justify-content-center flex-shrink-0\" aria-hidden=\"true\"><i class=\"fa fa-money sl-text-primary\"></i></div>\n<a class=\"text-decoration-none sl-text-muted sl-footer-link sl-footer-nav-link stretched-link\" data-sl-edit=\"link\" href=\"#finance\">Finance</a>\n</div>\n</div>\n</div>\n<div class=\"col-md-3 col-sm-6 mb-4 mb-md-0\">\n<div class=\"d-flex flex-column gap-2\">\n<div class=\"sl-cat-row d-flex align-items-center gap-3 position-relative\">\n<div class=\