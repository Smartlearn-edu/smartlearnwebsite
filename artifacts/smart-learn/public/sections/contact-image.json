  "meta": {
    "name": "Contact Image Split",
    "category": "Contact",
    "variant": "Image Split",
    "description": "A 50/50 layout with a beautiful full-height image on one side and a form on the other.",
    "tags": [
      "contact",
      "image",
      "split",
      "form"
    ],
    "image_count": 1
