  "html": "<!-- sl-section: contact-image | v1.0 -->\n<div class=\"sl-contact-image\">\n<div class=\"container-fluid p-0\">\n<div class=\"row g-0\">\n<div class=\"col-lg-6 d-none d-lg-block\">\n<div class=\"image-wrapper w-100 h-100\" style=\"min-height: 600px;\">\n<img alt=\"Customer Support\" class=\"w-100 h-100 object-fit-cover\" data-sl-edit=\"image\" src=\"https://images.unsplash.com/photo-1521737604893-d14cc237f11d?ixlib=rb-4.0.3&amp;auto=format&amp;fit=crop&amp;w=1200&amp;q=80\"/>\n</div>\n</div>\n<div class=\"col-lg-6 d-flex align-items-center bg-body\">\n<div class=\"form-wrapper w-100 p-5 px-xl-5 py-xl-5 m-xl-5\">\n<h2 class=\"fw-bold display-6 mb-3\" data-sl-edit=\"text\">Get in touch today.</h2>\n<p class=\"text-muted fs-5 mb-5\" data-sl-edit=\"text\">Whether you have a question about features, pricing, or anything else, our team is ready to answer all your questions.</p>\n<form>\n<div class=\"row g-4\">\n<div class=\"col-md-6\">\n<label class=\"form-label fw-semibold\">Name</label>\n<input class=\"form-control border-secondary-subtle py-2\" placeholder=\"Jane Doe\" type=\"text\"/>\n</div>\n<div class=\"col-md-6\">\n<label class=\"form-label fw-semibold\">Email</label>\n<input class=\"form-control border-secondary-subtle py-2\" placeholder=\"jane@company.com\" type=\"email\"/>\n</div>\n<div class=\"col-12\">\n<label class=\"form-label fw-semibold\">Subject</label>\n<select class=\"form-select border-secondary-subtle py-2\">\n<option>General Inquiry</option>\n<option>Sales &amp; Pricing</option>\n<option>Technical Support</option>\n</select>\n</div>\n<div class=\"col-12\">\n<label class=\"form-label fw-semibold\">Message</label>\n<textarea class=\"form-control border-secondary-subtle py-2\" placeholder=\"How can we help you?\" rows=\"5\"></textarea>\n</div>\n<div class=\"col-12 mt-4\">\n<button class=\"btn btn-primary px-5 py-3 fw-bold rounded-pill\" data-sl-edit=\"text\" type=\"button\">Send Message</button>\n</div>\n</div>\n</form>\n</div>\n</div>\n</div>\n</div>\n</div>",
  "css": ".sl-contact-image {\n    background-color: var(--bs-body-bg);\n}\n.sl-contact-image .object-fit-cover {\n    object-fit: cover;\n}\n.sl-contact-image .form-control:focus, .sl-contact-image .form-select:focus {\n    border-color: var(--sl-primary, #0d6efd);\n    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);\n}",
  "js": "(function() {\n    const root = document.querySelector('.sl-contact-image');\n    if (!root) return;\n})();"
}